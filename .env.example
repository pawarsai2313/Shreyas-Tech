# Frontend (public values only — safe to expose)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Optional; the function does not require it because verify_jwt = false
VITE_SUPABASE_ANON_KEY=

# NEVER put these in frontend code or .env files committed to git.
# Set them as Supabase secrets instead:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set CONTACT_FROM_EMAIL="SHREYAS TECHNOLOGIES <hello@yourdomain.com>"
